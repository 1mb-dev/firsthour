{
  // Fixture-backed Worker for `make mock`. Never deployed.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "firsthour-mock",
  "main": "test/mock/worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": true },
  "kv_namespaces": [{ "binding": "SNAPSHOTS", "id": "firsthour-mock-local" }]
}
