{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "firsthour",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    // Every response, static or API, goes through the Worker so security headers live in one place.
    "run_worker_first": true
  },
  "routes": [{ "pattern": "firsthour.1mb.dev", "custom_domain": true }],
  "kv_namespaces": [
    // "firsthour-snapshots". Written only by the Worker's refresh cron; `wrangler dev` uses local storage.
    { "binding": "SNAPSHOTS", "id": "99cad86197e943a585807e31e78e0da2" }
  ],
  // Copies the snapshots that snapshots.yml publishes to GitHub Pages into SNAPSHOTS (src/refresh.ts).
  "triggers": { "crons": ["*/15 * * * *"] },
  "observability": { "enabled": true }
}
